# Frontend settings (Vite). Only variables starting with VITE_ are visible to the app.
#
# LOCAL DEVELOPMENT: you don't need a .env at all — it defaults to
#   http://localhost:8080 (REST) and http://localhost:8080/ws (WebSocket).
#
# PRODUCTION: set these on your frontend host (Vercel / Netlify / ...) or in
# a .env.production file BEFORE running `npm run build` — Vite bakes them into
# the built files. Use https:// (SockJS switches to wss:// automatically).
#   VITE_API_URL=https://your-backend-domain
#   (VITE_WS_URL is optional; defaults to ${VITE_API_URL}/ws)

VITE_API_URL=http://localhost:8080
# VITE_WS_URL=http://localhost:8080/ws
