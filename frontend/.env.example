# Base URL of the backend API. Point this at your deployed backend in
# production (e.g. https://api.one23.app); defaults to the local dev
# backend on port 8080 if unset.
VITE_API_URL=http://localhost:8080

# WebSocket (STOMP/SockJS) endpoint. Optional — defaults to
# `${VITE_API_URL}/ws` if unset.
# VITE_WS_URL=http://localhost:8080/ws
